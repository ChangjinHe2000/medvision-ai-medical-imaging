# MedVision Windows local-workstation configuration example.
# Copy this file to .env.local and replace X: paths and CHANGE_ME values locally.
# Never commit .env.local, passwords, session secrets, medical images or model weights.

# Service
PPGL_API_HOST=127.0.0.1
PPGL_API_PORT=8000
PPGL_API_RELOAD=false
PPGL_API_LOG_LEVEL=info
PPGL_DEPLOYMENT_ENVIRONMENT=development
PPGL_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_API_BASE_URL=/api
VITE_CSRF_COOKIE_NAME=medvision_csrf
VITE_HOST=127.0.0.1
VITE_PORT=5173

# External runtime storage. Use forward slashes or escaped backslashes on Windows.
PPGL_DATA_ROOT=X:/MedVisionRuntime
PPGL_CASES_DIR=X:/MedVisionRuntime/cases
PPGL_CASE_TRASH_DIR=X:/MedVisionRuntime/trash/ct
PPGL_LOG_DIR=X:/MedVisionRuntime/logs
PPGL_TEMP_DIR=X:/MedVisionRuntime/temp
PPGL_PID_DIR=X:/MedVisionRuntime/pids
PPGL_TASKS_DIR=X:/MedVisionRuntime/tasks
PPGL_TEST_RESULTS_DIR=X:/MedVisionRuntime/test-results
PPGL_MAX_UPLOAD_MB=2048
PPGL_STORAGE_PROTECTED=false

# Runtime executables. Plain command names are preferred when available on PATH.
PPGL_PYTHON_BIN=python
# PPGL_NODE_BIN=X:/Tools/Node/node-v24.20.0-win-x64/node.exe
# PPGL_NPM_BIN=X:/Tools/Node/node-v24.20.0-win-x64/npm.cmd
# PPGL_GLTFPACK_BIN=X:/path/to/gltfpack.cmd

# ProgressPatchV5 PPGL model and TotalSegmentator offline weights.
PPGL_V5_CHECKPOINT=X:/MedVisionModels/ppgl/weights/model_best.pth
PPGL_V5_MODEL_CONFIG=model_config.json
TOTALSEG_WEIGHTS_PATH=X:/MedVisionModels/totalsegmentator/nnunet/results
TOTALSEG_HOME_DIR=X:/MedVisionRuntime/totalsegmentator
PPGL_CT_MAX_UPLOAD_MB=4096
PPGL_CT_TIMEOUT_SECONDS=7200

# Brain tumour nnU-Net stable snapshot. Never point to a live training directory.
PPGL_ENABLE_NNUNET_INFERENCE=false
PPGL_NNUNET_MODEL_DIR=X:/MedVisionModels/brain-tumour/Dataset001_BrainTumour/nnUNetTrainer__nnUNetPlans__3d_fullres
PPGL_NNUNET_DATASET=Dataset001_BrainTumour
PPGL_NNUNET_CONFIGURATION=3d_fullres
PPGL_NNUNET_FOLD=0
PPGL_NNUNET_CHECKPOINT=checkpoint_best.pth
PPGL_NNUNET_TRAINER=nnUNetTrainer
PPGL_NNUNET_PLANS=nnUNetPlans
PPGL_NNUNET_STEP_SIZE=0.5
PPGL_NNUNET_DISABLE_TTA=false
PPGL_NNUNET_PREPROCESS_PROCESSES=2
PPGL_NNUNET_EXPORT_PROCESSES=2
PPGL_TASK_TIMEOUT_SECONDS=7200
PPGL_GPU_LOCK_FILE=X:/MedVisionRuntime/pids/gpu.lock

# Native nnU-Net environment variables used by nnUNetv2_predict.
nnUNet_raw=X:/MedVisionRuntime/nnunet/raw
nnUNet_preprocessed=X:/MedVisionRuntime/nnunet/preprocessed
nnUNet_results=X:/MedVisionModels/brain-tumour

# Brain MRI storage and inference configuration used by the unified /api/v1 service.
PPGL_GLIOMA_ENABLED=false
PPGL_GLIOMA_CASES_DIR=X:/MedVisionRuntime/brain-cases
PPGL_GLIOMA_TRASH_DIR=X:/MedVisionRuntime/trash/brain-mri
PPGL_GLIOMA_MODEL_DIR=X:/MedVisionModels/brain-tumour/Dataset001_BrainTumour/nnUNetTrainer__nnUNetPlans__3d_fullres
PPGL_GLIOMA_DEVICE=cuda
PPGL_GLIOMA_MAX_UPLOAD_MB=2048
PPGL_GLIOMA_TIMEOUT_SECONDS=7200
# Only enable while an old frontend still calls /api/brain; the formal service uses /api/v1/cases.
PPGL_ENABLE_LEGACY_BRAIN_API=false

# Windows single-machine accounts/cases. RAG uses its separate PostgreSQL connection below.
PPGL_AUTH_DATABASE_URL=sqlite:///X:/MedVisionRuntime/database/medvision-enterprise.db
# Optional PostgreSQL account/case database (create the database and role first):
# PPGL_AUTH_DATABASE_URL=postgresql+psycopg://medvision_app:CHANGE_ME@127.0.0.1:5432/medvision
PPGL_AUTH_SESSION_HOURS=8
PPGL_AUTH_COOKIE_SECURE=false
PPGL_AUTH_SESSION_COOKIE=medvision_session
PPGL_AUTH_CSRF_COOKIE=medvision_csrf
# 正式环境保持 false；首个管理员通过 scripts/windows/initialize_enterprise_database.py 创建。
PPGL_ALLOW_WEB_ADMIN_SETUP=false

# Migration-only secrets required by the current partner backend until Cookie auth replaces JWT.
PPGL_AUTH_JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
PPGL_INTERNAL_API_KEY=CHANGE_ME_TO_A_DIFFERENT_RANDOM_SECRET

# Retention and safe deletion. Keep destructive automation disabled initially.
PPGL_TRASH_RETENTION_DAYS=30
PPGL_RETENTION_POLICY_APPROVED=false
PPGL_RETENTION_DEVELOPMENT_DAYS=30
PPGL_RETENTION_PURGE_ENABLED=false

# Ollama local assistant.
PPGL_ENABLE_OLLAMA=false
PPGL_OLLAMA_BASE_URL=http://127.0.0.1:11434
PPGL_OLLAMA_MODEL=qwen2.5:3b-instruct-q4_0
# PPGL_OLLAMA_BIN=X:/LLM/Ollama/ollama.exe
PPGL_OLLAMA_CONNECT_TIMEOUT_SECONDS=2
PPGL_OLLAMA_READ_TIMEOUT_SECONDS=120
PPGL_OLLAMA_MAX_OUTPUT_TOKENS=1024
PPGL_OLLAMA_KEEP_ALIVE=5m

# PostgreSQL + pgvector medical RAG. Keep disabled until the new database is initialized.
PPGL_RAG_ENABLED=false
PPGL_RAG_INDEXING_ENABLED=false
PPGL_RAG_DATABASE_URL=postgresql+psycopg://medvision_app:CHANGE_ME@127.0.0.1:5432/medvision
PPGL_RAG_KNOWLEDGE_DIR=X:/MedVisionRuntime/rag
PPGL_RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
PPGL_RAG_EMBEDDING_DIMENSION=1024
PPGL_RAG_EMBEDDING_BATCH_SIZE=8
PPGL_RAG_EMBEDDING_KEEP_ALIVE=0
PPGL_RAG_MAX_DOCUMENT_MB=100
PPGL_RAG_CHUNK_SIZE=700
PPGL_RAG_CHUNK_OVERLAP=100
PPGL_RAG_RETRIEVAL_TOP_K=15
PPGL_RAG_CONTEXT_TOP_K=5
PPGL_RAG_MIN_SCORE=0.0
PPGL_RAG_MAX_CONTEXT_CHARS=12000
PPGL_RAG_REQUEST_TIMEOUT_SECONDS=60
